<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MAUIProfilePowerMgrSample1.MainPage"
             Title="Profile PowerMgr Sample">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="20">

            <Label
                Text="Power Manager Profile"
                FontSize="22"
                FontAttributes="Bold" />

            <Label Text="Select an action to apply to the EMDK PowerMgr profile:" />

            <RadioButton
                x:Name="RadioSuspend"
                Content="Suspend (sleep mode)"
                IsChecked="True"
                GroupName="pwr" />

            <RadioButton
                x:Name="RadioReset"
                Content="Perform reset (reboot)"
                GroupName="pwr" />

            <Button
                x:Name="BtnSet"
                Text="Set"
                HorizontalOptions="Center"
                Clicked="OnSetClicked" />

            <Label Text="Status:" FontAttributes="Bold" Margin="0,20,0,0" />

            <Label
                x:Name="StatusLabel"
                Text=""
                LineBreakMode="WordWrap" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

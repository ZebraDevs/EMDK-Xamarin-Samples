<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MAUISerialCommSample.MainPage"
             Title="Serial Comm Sample">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Label Text="Serial Communication" FontSize="22" FontAttributes="Bold" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Grid.Column="0" x:Name="WriteButton" Text="Write" IsEnabled="False" Clicked="OnWriteClicked" />
                <Button Grid.Column="1" x:Name="ReadButton" Text="Read" IsEnabled="False" Clicked="OnReadClicked" />
            </Grid>

            <Label Text="Write Data:" />
            <Entry x:Name="WriteEntry" IsEnabled="False" Text="Serial Communication Write Data Testing." />

            <Label Text="Status:" FontAttributes="Bold" Margin="0,10,0,0" />
            <Label x:Name="StatusLabel" Text="" LineBreakMode="WordWrap" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

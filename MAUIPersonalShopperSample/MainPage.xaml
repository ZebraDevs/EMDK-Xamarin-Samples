<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MAUIPersonalShopperSample.MainPage"
             Title="Personal Shopper Sample">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <Label Text="Personal Shopper (Cradle)" FontSize="22" FontAttributes="Bold" />

            <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="6">
                <CheckBox x:Name="FastChargeCheck" Grid.Column="0" CheckedChanged="OnFastChargeChanged" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="Fast Charge" VerticalOptions="Center" />
                <CheckBox x:Name="SmoothCheck" Grid.Column="2" VerticalOptions="Center" />
                <Label Grid.Column="3" Text="Smooth Effect" VerticalOptions="Center" />
            </Grid>

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                <Button Grid.Row="0" Grid.Column="0" Text="Cradle Info" Clicked="OnCradleInfoClicked" />
                <Button Grid.Row="0" Grid.Column="1" Text="Diagnostic Info" Clicked="OnDiagnosticClicked" />
                <Button Grid.Row="1" Grid.Column="0" Text="Cradle Unlock" Clicked="OnUnlockClicked" />
                <Button Grid.Row="1" Grid.Column="1" Text="Flash LED's" Clicked="OnFlashClicked" />
            </Grid>

            <Label Text="Status:" FontAttributes="Bold" Margin="0,10,0,0" />
            <Label x:Name="StatusLabel" Text="" LineBreakMode="WordWrap" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

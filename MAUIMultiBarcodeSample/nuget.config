<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Local fallback so the Zebra EMDK binding restores even offline. -->
    <add key="local-emdk" value="local-nuget" />
  </packageSources>
</configuration>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
	<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
	<uses-permission android:name="android.permission.INTERNET" />
	<!-- Required to use the Zebra EMDK ProfileManager. -->
	<uses-permission android:name="com.symbol.emdk.permission.EMDK" />
	<!-- Android 11+ package visibility: apps targeting API 30+ cannot see (or bind to) the
	     EMDK service unless it is declared here. Without this, GetEMDKManager fails with
	     "Unable to start service ... com.symbol.emdk.emdkservice/.EMDKService ... not found". -->
	<queries>
		<package android:name="com.symbol.emdk.emdkservice" />
	</queries>
	<application android:allowBackup="true" android:icon="@mipmap/appicon" android:supportsRtl="true">
		<!-- Links the EMDK shared library provided by Zebra devices. -->
		<uses-library android:name="com.symbol.emdk" android:required="false" />
	</application>
</manifest>